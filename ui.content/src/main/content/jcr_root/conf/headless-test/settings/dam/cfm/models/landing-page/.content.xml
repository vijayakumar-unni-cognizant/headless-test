<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:cq="http://www.day.com/jcr/cq/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
          jcr:primaryType="cq:Template"
          allowedPaths="[/content/dam/headless-test(/.*)?]"
          ranking="{Long}100">
  <jcr:content
    jcr:primaryType="cq:PageContent"
    jcr:title="Landing Page"
    description="Aggregator fragment for one page: SEO metadata plus references to a hero, stats, content sections, and pillars."
    status="enabled"
    sling:resourceType="dam/cfm/models/console/components/data/entity/default"
    sling:resourceSuperType="dam/cfm/models/console/components/data/entity"
    cq:scaffolding="/conf/headless-test/settings/dam/cfm/models/landing-page/jcr:content/model"
    cq:templateType="/libs/settings/dam/cfm/model-types/fragment">
    <metadata jcr:primaryType="nt:unstructured"/>
    <model
      jcr:primaryType="cq:PageContent"
      dataTypesConfig="/mnt/overlay/settings/dam/cfm/models/formbuilderconfig/datatypes"
      sling:resourceType="wcm/scaffolding/components/scaffolding"
      maxGeneratedOrder="20"
      cq:targetPath="/content/dam/headless-test">
      <cq:dialog
        jcr:primaryType="nt:unstructured"
        sling:resourceType="cq/gui/components/authoring/dialog">
        <content
          jcr:primaryType="nt:unstructured"
          sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
          <items
            jcr:primaryType="nt:unstructured"
            maxGeneratedOrder="20">
            <slug
              jcr:primaryType="nt:unstructured"
              listOrder="1"
              valueType="string"
              showEmptyInReadOnly="true"
              metaType="text-single"
              required="on"
              name="slug"
              maxlength="255"
              fieldLabel="Slug"
              sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
              renderReadOnly="false">
              <granite:data jcr:primaryType="nt:unstructured"/>
            </slug>
            <seoTitle
              jcr:primaryType="nt:unstructured"
              listOrder="2"
              valueType="string"
              showEmptyInReadOnly="true"
              metaType="text-single"
              required="on"
              name="seoTitle"
              maxlength="255"
              fieldLabel="SEO Title"
              sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
              renderReadOnly="false">
              <granite:data jcr:primaryType="nt:unstructured"/>
            </seoTitle>
            <seoDescription
              jcr:primaryType="nt:unstructured"
              listOrder="3"
              valueType="string/multiline"
              showEmptyInReadOnly="true"
              metaType="text-multi"
              cfm-element="SEO Description"
              name="seoDescription"
              sling:resourceType="dam/cfm/admin/components/authoring/contenteditor/multieditor"
              renderReadOnly="false"
              default-mime-type="text/html"/>
            <hero
              jcr:primaryType="nt:unstructured"
              filter="fragments"
              listOrder="4"
              valueType="string/reference"
              metaType="fragment-reference"
              rootPath="/content/dam/headless-test/chisel/fragments"
              cfModelPath="/conf/headless-test/settings/dam/cfm/models/hero"
              name="hero"
              fieldLabel="Hero"
              showThumbnail="true"
              sling:resourceType="dam/cfm/models/editor/components/fragmentreference"
              renderReadOnly="false">
              <granite:data jcr:primaryType="nt:unstructured" showThumbnail="true"/>
            </hero>
            <stats
              jcr:primaryType="nt:unstructured"
              filter="fragments"
              listOrder="5"
              valueType="string/reference[]"
              metaType="fragment-reference"
              rootPath="/content/dam/headless-test/chisel/fragments"
              cfModelPath="/conf/headless-test/settings/dam/cfm/models/stat"
              name="stats"
              fieldLabel="Stats"
              showThumbnail="true"
              sling:resourceType="dam/cfm/models/editor/components/fragmentreference"
              renderReadOnly="false">
              <granite:data jcr:primaryType="nt:unstructured" showThumbnail="true"/>
            </stats>
            <sections
              jcr:primaryType="nt:unstructured"
              filter="fragments"
              listOrder="6"
              valueType="string/reference[]"
              metaType="fragment-reference"
              rootPath="/content/dam/headless-test/chisel/fragments"
              cfModelPath="/conf/headless-test/settings/dam/cfm/models/content-section"
              name="sections"
              fieldLabel="Sections"
              showThumbnail="true"
              sling:resourceType="dam/cfm/models/editor/components/fragmentreference"
              renderReadOnly="false">
              <granite:data jcr:primaryType="nt:unstructured" showThumbnail="true"/>
            </sections>
            <pillars
              jcr:primaryType="nt:unstructured"
              filter="fragments"
              listOrder="7"
              valueType="string/reference[]"
              metaType="fragment-reference"
              rootPath="/content/dam/headless-test/chisel/fragments"
              cfModelPath="/conf/headless-test/settings/dam/cfm/models/pillar"
              name="pillars"
              fieldLabel="Pillars"
              showThumbnail="true"
              sling:resourceType="dam/cfm/models/editor/components/fragmentreference"
              renderReadOnly="false">
              <granite:data jcr:primaryType="nt:unstructured" showThumbnail="true"/>
            </pillars>
          </items>
        </content>
      </cq:dialog>
    </model>
  </jcr:content>
</jcr:root>
