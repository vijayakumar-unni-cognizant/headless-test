<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:cq="http://www.day.com/jcr/cq/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
          jcr:primaryType="cq:Template"
          allowedPaths="[/content/dam/headless-test(/.*)?]"
          ranking="{Long}100">
  <jcr:content
    jcr:primaryType="cq:PageContent"
    jcr:title="Pillar"
    description="A reusable card-shaped item (offer, approach, product, role, film, community item, ...) grouped by category."
    status="enabled"
    sling:resourceType="dam/cfm/models/console/components/data/entity/default"
    sling:resourceSuperType="dam/cfm/models/console/components/data/entity"
    cq:scaffolding="/conf/headless-test/settings/dam/cfm/models/pillar/jcr:content/model"
    cq:templateType="/libs/settings/dam/cfm/model-types/fragment">
    <metadata jcr:primaryType="nt:unstructured"/>
    <model
      jcr:primaryType="cq:PageContent"
      dataTypesConfig="/mnt/overlay/settings/dam/cfm/models/formbuilderconfig/datatypes"
      sling:resourceType="wcm/scaffolding/components/scaffolding"
      maxGeneratedOrder="20"
      cq:targetPath="/content/dam/headless-test">
      <cq:dialog
        jcr:primaryType="nt:unstructured"
        sling:resourceType="cq/gui/components/authoring/dialog">
        <content
          jcr:primaryType="nt:unstructured"
          sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
          <items
            jcr:primaryType="nt:unstructured"
            maxGeneratedOrder="20">
            <title
              jcr:primaryType="nt:unstructured"
              listOrder="1"
              valueType="string"
              showEmptyInReadOnly="true"
              metaType="text-single"
              required="on"
              name="title"
              maxlength="255"
              fieldLabel="Title"
              sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
              renderReadOnly="false">
              <granite:data jcr:primaryType="nt:unstructured"/>
            </title>
            <description
              jcr:primaryType="nt:unstructured"
              listOrder="2"
              translatable="true"
              valueType="string/multiline"
              showEmptyInReadOnly="true"
              metaType="text-multi"
              cfm-element="Description"
              name="description"
              sling:resourceType="dam/cfm/admin/components/authoring/contenteditor/multieditor"
              renderReadOnly="false"
              default-mime-type="text/html"/>
            <category
              jcr:primaryType="nt:unstructured"
              listOrder="3"
              valueType="string"
              showEmptyInReadOnly="true"
              metaType="enumeration"
              name="category"
              fieldLabel="Category"
              emptyOption="{Boolean}true"
              sling:resourceType="granite/ui/components/coral/foundation/form/select"
              renderReadOnly="false">
              <optionsmultifield jcr:primaryType="nt:unstructured">
                <item0
                  jcr:primaryType="nt:unstructured"
                  fieldLabel="Capital"
                  fieldValue="capital"/>
                <item1
                  jcr:primaryType="nt:unstructured"
                  fieldLabel="Technology"
                  fieldValue="technology"/>
                <item2
                  jcr:primaryType="nt:unstructured"
                  fieldLabel="Community"
                  fieldValue="community"/>
                <item3
                  jcr:primaryType="nt:unstructured"
                  fieldLabel="Offering"
                  fieldValue="offering"/>
                <item4
                  jcr:primaryType="nt:unstructured"
                  fieldLabel="Partnership"
                  fieldValue="partnership"/>
                <item5
                  jcr:primaryType="nt:unstructured"
                  fieldLabel="Approach"
                  fieldValue="approach"/>
                <item6
                  jcr:primaryType="nt:unstructured"
                  fieldLabel="Product"
                  fieldValue="product"/>
                <item7
                  jcr:primaryType="nt:unstructured"
                  fieldLabel="Differentiator"
                  fieldValue="differentiator"/>
                <item8
                  jcr:primaryType="nt:unstructured"
                  fieldLabel="Role"
                  fieldValue="role"/>
                <item9
                  jcr:primaryType="nt:unstructured"
                  fieldLabel="Film"
                  fieldValue="film"/>
              </optionsmultifield>
              <datasource
                jcr:primaryType="nt:unstructured"
                variant="default"
                sling:resourceType="dam/cfm/admin/components/datasources/optionrendererenumeration"/>
              <granite:data jcr:primaryType="nt:unstructured"/>
            </category>
            <linkLabel
              jcr:primaryType="nt:unstructured"
              listOrder="4"
              valueType="string"
              showEmptyInReadOnly="true"
              metaType="text-single"
              name="linkLabel"
              maxlength="255"
              fieldLabel="Link Label"
              sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
              renderReadOnly="false">
              <granite:data jcr:primaryType="nt:unstructured"/>
            </linkLabel>
            <linkPath
              jcr:primaryType="nt:unstructured"
              listOrder="5"
              valueType="string"
              showEmptyInReadOnly="true"
              metaType="text-single"
              name="linkPath"
              maxlength="255"
              fieldLabel="Link Path"
              sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
              renderReadOnly="false">
              <granite:data jcr:primaryType="nt:unstructured"/>
            </linkPath>
            <image
              jcr:primaryType="nt:unstructured"
              filter="hierarchy"
              listOrder="6"
              valueType="string/reference"
              nameSuffix="contentReference"
              showEmptyInReadOnly="true"
              metaType="reference"
              rootPath="/content/dam/headless-test"
              validation="cfm.validation.contenttype.image"
              name="image"
              fieldLabel="Image"
              showThumbnail="true"
              sling:resourceType="dam/cfm/models/editor/components/contentreference"
              renderReadOnly="false">
              <granite:data
                jcr:primaryType="nt:unstructured"
                showThumbnail="true"
                thumbnail-validation="cfm.validation.thumbnail.show"/>
            </image>
            <imageAlt
              jcr:primaryType="nt:unstructured"
              listOrder="7"
              valueType="string"
              showEmptyInReadOnly="true"
              metaType="text-single"
              name="imageAlt"
              maxlength="255"
              fieldLabel="Image Alt Text"
              sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
              renderReadOnly="false">
              <granite:data jcr:primaryType="nt:unstructured"/>
            </imageAlt>
          </items>
        </content>
      </cq:dialog>
    </model>
  </jcr:content>
</jcr:root>
